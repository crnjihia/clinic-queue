# path: .env.example
# Application Environment & Flavor
FLAVOR=dev
USE_MOCK_SERVICES=true

# Firebase Emulator Suite (Local Development)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Safaricom Daraja M-Pesa Sandbox (Kenyan STK Push payments)
DARAJA_CONSUMER_KEY=sandbox_consumer_key_here
DARAJA_CONSUMER_SECRET=sandbox_consumer_secret_here
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_CALLBACK_URL=https://us-central1-clinic-queue-dev.cloudfunctions.net/mpesaCallback

# Africa's Talking Sandbox (Kenyan SMS / WhatsApp alerts)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=sandbox_api_key_here
AFRICAS_TALKING_SENDER_ID=CLINICQUEUE

# Regional Defaults
DEFAULT_LOCALE=en
TIMEZONE=Africa/Nairobi
CURRENCY_CODE=KES
